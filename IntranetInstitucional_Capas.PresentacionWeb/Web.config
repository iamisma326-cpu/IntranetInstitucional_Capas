<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <add name="CnxBD_Intranet"
       connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=BD_INTRANET_2026;Integrated Security=True;Encrypt=False;"
       providerName="System.Data.SqlClient" />
    <add name="BD_INTRANETConnectionString"
       connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=BD_INTRANET_2026;Integrated Security=True;Encrypt=False;"
       providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="false" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="4096" />
    <customErrors mode="Off" />
    <sessionState mode="InProc" timeout="60" />
  </system.web>

</configuration>
