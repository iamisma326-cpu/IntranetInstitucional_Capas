<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Sitio.master.cs" Inherits="IntranetInstitucional_Capas.PresentacionWeb.Sitio" %>

<!DOCTYPE html>
<html lang="es" data-theme="light">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AQUILA A-ERP | IESTP Argentina</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.7.2/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            darkMode: ['class', '[data-theme="dark"]'],
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        aquila: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            200: '#bae0fd',
                            500: '#0ea5e9',
                            700: '#0369a1',
                            900: '#0c4a6e',
                            950: '#082f49',
                        }
                    }
                }
            }
        }
    </script>

    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('aquila-theme') || 'light';
                document.documentElement.setAttribute('data-theme', savedTheme);
                if (savedTheme === 'dark') {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            } catch (e) { }
        })();
    </script>

    <meta name="theme-color" content="#0b132b" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: background-color 0.2s ease, color 0.2s ease;
        }
        [data-theme="dark"] { color-scheme: dark; }
        [data-theme="light"] { color-scheme: light; }
        html { scroll-behavior: smooth; }
    </style>

    <asp:ContentPlaceHolder ID="EstilosPagina" runat="server" />
</head>

<body class="bg-slate-50 dark:bg-[#0b0f19] min-h-screen flex flex-col text-slate-800 dark:text-slate-200 selection:bg-blue-600 selection:text-white transition-colors duration-200">
    <form id="formPrincipal" runat="server">

        <div class="drawer lg:drawer-open flex-1">
            <input id="main-drawer" type="checkbox" class="drawer-toggle" />

            <div class="drawer-content flex flex-col">

                <header class="navbar bg-slate-900/95 dark:bg-[#0f172a]/95 backdrop-blur-md text-white shadow-sm sticky top-0 z-30 px-4 lg:px-8 h-16 min-h-0 border-b border-slate-800 transition-colors">
                    <div class="flex-none lg:hidden">
                        <label for="main-drawer" aria-label="Abrir menu" class="btn btn-square btn-ghost btn-sm text-white">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                        </label>
                    </div>

                    <div class="flex-1 items-center gap-3">
                        <a href="Default.aspx" class="flex items-center gap-2.5 group">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-slate-900 to-blue-950 border border-cyan-400/40 p-1.5 flex items-center justify-center shadow-sm shrink-0">
                                <svg viewBox="0 0 100 100" class="w-full h-full drop-shadow-[0_0_6px_rgba(56,189,248,0.7)]" fill="none">
                                    <defs>
                                        <linearGradient id="navWingL" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#38bdf8" /><stop offset="100%" stop-color="#1d4ed8" /></linearGradient>
                                        <linearGradient id="navWingR" x1="100%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#60a5fa" /><stop offset="100%" stop-color="#2563eb" /></linearGradient>
                                        <linearGradient id="navCore" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#ffffff" /><stop offset="100%" stop-color="#93c5fd" /></linearGradient>
                                    </defs>
                                    <polygon points="48,10 4,68 32,60 46,38" fill="url(#navWingL)" />
                                    <polygon points="52,10 96,68 68,60 54,38" fill="url(#navWingR)" />
                                    <polygon points="50,6 43,44 50,88 57,44" fill="url(#navCore)" />
                                    <polygon points="50,22 46,44 50,70 54,44" fill="#0284c7" />
                                </svg>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-base font-black tracking-tight text-white">AQUILA</span>
                                <span class="text-[10px] bg-cyan-500/20 text-cyan-300 px-2 py-0.5 rounded font-bold border border-cyan-500/30">A-ERP</span>
                            </div>
                        </a>
                    </div>

                    <div class="flex-none items-center gap-2.5">

                        <div id="itemSelectorRol" runat="server" class="relative flex items-center">
                            <asp:DropDownList ID="ddlRolActivo" runat="server"
                                AutoPostBack="true"
                                OnSelectedIndexChanged="ddlRolActivo_SelectedIndexChanged"
                                CssClass="appearance-none rounded-xl bg-slate-800/90 hover:bg-slate-700/90 text-cyan-300 border border-slate-700/80 font-bold text-[11px] tracking-tight h-8 pl-3 pr-7 cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500/50 transition">
                            </asp:DropDownList>
                            <svg class="w-3 h-3 text-slate-400 absolute right-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                        </div>

                        <button type="button" onclick="toggleAquilaTheme()" class="btn btn-ghost btn-sm btn-circle text-amber-300 hover:bg-white/10 transition" title="Alternar Modo Oscuro">
                            <svg class="theme-icon-sun w-5 h-5 hidden text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                            <svg class="theme-icon-moon w-5 h-5 text-cyan-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
                        </button>

                        <div class="dropdown dropdown-end">
                            <div tabindex="0" role="button" class="btn btn-ghost btn-sm flex items-center gap-2 normal-case rounded-xl px-2 py-1.5 h-auto hover:bg-white/10 text-white">
                                <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center text-xs font-bold shadow-inner">
                                    <span id="spanIniciales" runat="server">US</span>
                                </div>
                                <span class="text-xs font-semibold hidden md:inline" id="spanNombre" runat="server"></span>
                                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            </div>
                            <ul tabindex="0" class="dropdown-content z-[20] menu p-2 shadow-xl bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 rounded-2xl w-52 border border-slate-200 dark:border-slate-700 mt-2 text-xs">
                                <li class="px-3 py-1 text-[11px] text-slate-400 font-semibold uppercase">Rol Activo: <span id="spanRolActivo" runat="server"></span></li>
                                <li class="divider my-1 border-slate-100 dark:border-slate-700"></li>
                                <li>
                                    <asp:LinkButton ID="lnkCerrarSesion" runat="server" OnClick="lnkCerrarSesion_Click"
                                        CssClass="text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 font-semibold py-2 rounded-xl">
                                        Cerrar Sesion
                                    </asp:LinkButton>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <main class="flex-1 p-4 lg:p-8 max-w-7xl w-full mx-auto">
                    <asp:PlaceHolder ID="phAlerta" runat="server" />
                    <asp:ContentPlaceHolder ID="ContenidoPrincipal" runat="server" />
                </main>

                <footer class="p-5 bg-white dark:bg-[#0f172a] border-t border-slate-200 dark:border-slate-800 text-center text-xs text-slate-500 dark:text-slate-400">
                    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
                        <p class="font-medium">&#129413; AQUILA A-ERP &bull; IESTP "Argentina" 2026</p>
                        <p class="text-slate-400 dark:text-slate-500">Sitio Web con N Capas &bull; ADO.NET</p>
                    </div>
                </footer>
            </div>

            <div class="drawer-side z-40">
                <label for="main-drawer" aria-label="Cerrar menu" class="drawer-overlay"></label>
                <aside class="bg-white dark:bg-[#0f172a] w-64 min-h-full border-r border-slate-200 dark:border-slate-800 flex flex-col shadow-sm">

                    <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-slate-900 dark:bg-slate-800 text-cyan-400 flex items-center justify-center font-bold text-xs">
                            &#129413;
                        </div>
                        <div>
                            <h2 class="font-bold text-slate-900 dark:text-slate-100 text-xs tracking-tight">AQUILA ERP</h2>
                            <span class="text-[10px] text-slate-400 block -mt-0.5">IESTP Argentina</span>
                        </div>
                    </div>

                    <nav class="flex-1 p-3 space-y-1 overflow-y-auto text-xs">
                        <a id="lnkPanelPrincipal" runat="server" href="Default.aspx"
                            class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition">
                            <span class="text-slate-400">&#127968;</span>
                            <span>Panel Principal</span>
                        </a>

                        <div class="pt-3 pb-1 px-3 flex items-center justify-between">
                            <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Modulos Implementados</span>
                        </div>

                        <a id="lnkModulo02" runat="server" href="Modulo02.aspx"
                            class="flex items-center justify-between px-3 py-2 rounded-xl text-indigo-700 dark:text-indigo-300 bg-indigo-50/60 dark:bg-indigo-950/40 font-semibold hover:bg-indigo-100 dark:hover:bg-indigo-900/40 transition">
                            <span class="flex items-center gap-2">
                                <span>&#128197;</span>
                                <span class="truncate">02. Asistencia &amp; DPI</span>
                            </span>
                            <span class="text-[9px] bg-indigo-200 dark:bg-indigo-800 text-indigo-800 dark:text-indigo-100 font-bold px-1.5 py-0.5 rounded" title="Responsable BD: Sheyla">Sheyla</span>
                        </a>
                    </nav>

                    <div class="p-3 border-t border-slate-100 dark:border-slate-800">
                        <button type="button" onclick="toggleAquilaTheme()" class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                            <span class="flex items-center gap-2">
                                <span class="theme-icon-sun text-sm hidden">&#9728;&#65039;</span>
                                <span class="theme-icon-moon text-sm">&#127769;</span>
                                <span class="theme-mode-text">Modo Oscuro</span>
                            </span>
                            <span class="text-[10px] text-slate-400">Ctrl+T</span>
                        </button>
                    </div>
                </aside>
            </div>
        </div>

    </form>

    <script>
        function toggleAquilaTheme() {
            var currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
            var newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', newTheme);
            if (newTheme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
            localStorage.setItem('aquila-theme', newTheme);
            updateAquilaThemeIcons();
        }

        function updateAquilaThemeIcons() {
            var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            var suns = document.querySelectorAll('.theme-icon-sun');
            var moons = document.querySelectorAll('.theme-icon-moon');
            var textos = document.querySelectorAll('.theme-mode-text');
            for (var i = 0; i < suns.length; i++) { suns[i].classList.toggle('hidden', !isDark); }
            for (var j = 0; j < moons.length; j++) { moons[j].classList.toggle('hidden', isDark); }
            for (var k = 0; k < textos.length; k++) { textos[k].textContent = isDark ? 'Modo Claro' : 'Modo Oscuro'; }
        }

        document.addEventListener('DOMContentLoaded', updateAquilaThemeIcons);

        document.addEventListener('keydown', function (e) {
            if (e.ctrlKey && (e.key === 't' || e.key === 'T')) { e.preventDefault(); toggleAquilaTheme(); }
        });
    </script>

    <asp:ContentPlaceHolder ID="ScriptsPagina" runat="server" />
</body>
</html>
